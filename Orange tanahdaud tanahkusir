<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orange Pilled Space — Jl. Daud, Jakarta Selatan</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Bebas+Neue&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --orange: #F7931A;
    --orange-dim: #c4721200;
    --orange-glow: rgba(247,147,26,0.25);
    --orange-bright: #ffaa33;
    --black: #080808;
    --dark: #0d0d0d;
    --dark2: #131313;
    --gray: #888;
    --light: #e8e8e8;
    --white: #f5f5f5;
    --red: #ff3b3b;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--light);
    font-family: 'IBM Plex Sans', sans-serif;
    overflow-x: hidden;
    cursor: none;
  }

  /* CUSTOM CURSOR */
  .cursor {
    position: fixed; width: 10px; height: 10px;
    background: var(--orange); border-radius: 50%;
    pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: difference;
  }
  .cursor-ring {
    position: fixed; width: 36px; height: 36px;
    border: 1px solid var(--orange); border-radius: 50%;
    pointer-events: none; z-index: 9998;
    transform: translate(-50%, -50%);
    transition: all 0.12s ease-out;
    opacity: 0.5;
  }

  /* NOISE OVERLAY */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none; z-index: 1000; opacity: 0.4;
  }

  /* NAV */
  nav {
    position: fixed; top: 0; width: 100%;
    padding: 20px 60px;
    display: flex; align-items: center; justify-content: space-between;
    z-index: 500;
    border-bottom: 1px solid rgba(247,147,26,0.08);
    background: linear-gradient(to bottom, rgba(8,8,8,0.95) 0%, transparent 100%);
    backdrop-filter: blur(4px);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px; letter-spacing: 3px;
    color: var(--orange);
  }
  .nav-logo span { color: var(--white); }
  .nav-links { display: flex; gap: 36px; }
  .nav-links a {
    font-family: 'Space Mono', monospace;
    font-size: 11px; letter-spacing: 2px;
    color: var(--gray); text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--orange); }
  .nav-cta {
    font-family: 'Space Mono', monospace;
    font-size: 11px; letter-spacing: 2px;
    padding: 10px 22px;
    border: 1px solid var(--orange);
    color: var(--orange);
    background: transparent;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.25s;
  }
  .nav-cta:hover {
    background: var(--orange);
    color: var(--black);
  }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex; flex-direction: column;
    justify-content: center;
    padding: 160px 60px 100px;
    position: relative;
    overflow: hidden;
  }

  .hero-bg-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(247,147,26,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247,147,26,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridShift 20s linear infinite;
  }
  @keyframes gridShift {
    0% { background-position: 0 0; }
    100% { background-position: 60px 60px; }
  }

  .hero-glow {
    position: absolute;
    width: 700px; height: 700px;
    background: radial-gradient(circle, rgba(247,147,26,0.12) 0%, transparent 70%);
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    pointer-events: none;
    animation: glowPulse 4s ease-in-out infinite;
  }
  @keyframes glowPulse {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
  }

  .hero-eyebrow {
    font-family: 'Space Mono', monospace;
    font-size: 11px; letter-spacing: 4px;
    color: var(--orange);
    text-transform: uppercase;
    margin-bottom: 28px;
    display: flex; align-items: center; gap: 16px;
    position: relative; z-index: 2;
  }
  .hero-eyebrow::before {
    content: '';
    width: 40px; height: 1px;
    background: var(--orange);
  }

  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(72px, 12vw, 160px);
    line-height: 0.9;
    letter-spacing: 2px;
    position: relative; z-index: 2;
    color: var(--white);
  }
  .hero-title .orange { color: var(--orange); }
  .hero-title .outline {
    -webkit-text-stroke: 1px rgba(247,147,26,0.4);
    color: transparent;
  }

  .hero-sub {
    font-family: 'Space Mono', monospace;
    font-size: 13px; line-height: 2;
    color: var(--gray);
    margin-top: 40px;
    max-width: 420px;
    position: relative; z-index: 2;
    border-left: 2px solid var(--orange);
    padding-left: 20px;
  }

  .hero-actions {
    display: flex; gap: 20px; margin-top: 52px;
    position: relative; z-index: 2; align-items: center;
  }
  .btn-primary {
    font-family: 'Space Mono', monospace;
    font-size: 12px; letter-spacing: 3px;
    padding: 16px 40px;
    background: var(--orange);
    color: var(--black);
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 700;
    transition: all 0.25s;
    position: relative;
    overflow: hidden;
  }
  .btn-primary::after {
    content: '';
    position: absolute; inset: 0;
    background: rgba(255,255,255,0.15);
    transform: translateX(-110%) skewX(-15deg);
    transition: transform 0.35s;
  }
  .btn-primary:hover::after { transform: translateX(110%) skewX(-15deg); }
  .btn-primary:hover { box-shadow: 0 0 40px rgba(247,147,26,0.5); }

  .btn-secondary {
    font-family: 'Space Mono', monospace;
    font-size: 12px; letter-spacing: 3px;
    color: var(--gray);
    text-decoration: none;
    text-transform: uppercase;
    display: flex; align-items: center; gap: 10px;
    transition: color 0.2s;
  }
  .btn-secondary:hover { color: var(--orange); }
  .btn-secondary::before {
    content: '→';
    transition: transform 0.2s;
  }
  .btn-secondary:hover::before { transform: translateX(4px); }

  .hero-address {
    position: absolute; bottom: 48px; right: 60px;
    font-family: 'Space Mono', monospace;
    font-size: 10px; letter-spacing: 2px;
    color: rgba(136,136,136,0.5);
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .hero-badge {
    position: absolute; top: 120px; right: 80px;
    width: 140px; height: 140px;
    border: 1px solid rgba(247,147,26,0.2);
    border-radius: 50%;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 4px;
    animation: rotateSlow 30s linear infinite;
    z-index: 2;
  }
  .hero-badge-inner {
    text-align: center;
  }
  .hero-badge-inner .symbol {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px; color: var(--orange);
    line-height: 1;
  }
  .hero-badge-inner .label {
    font-family: 'Space Mono', monospace;
    font-size: 8px; letter-spacing: 2px;
    color: var(--gray);
    text-transform: uppercase;
  }
  @keyframes rotateSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .hero-badge::after {
    content: '• BITCOIN ONLY • SOUND MONEY • PROOF OF WORK •';
    position: absolute;
    font-family: 'Space Mono', monospace;
    font-size: 8px; letter-spacing: 2px;
    color: rgba(247,147,26,0.4);
    width: 100%; text-align: center;
    animation: rotateSlow 30s linear infinite reverse;
    /* circular text hack via SVG workaround — simplified */
  }

  /* TICKER */
  .ticker {
    background: var(--orange);
    padding: 12px 0;
    overflow: hidden;
    position: relative; z-index: 2;
  }
  .ticker-track {
    display: flex; gap: 0;
    animation: tickerRun 25s linear infinite;
    white-space: nowrap;
  }
  .ticker-track span {
    font-family: 'Space Mono', monospace;
    font-size: 11px; letter-spacing: 3px;
    color: var(--black);
    text-transform: uppercase;
    padding: 0 40px;
    font-weight: 700;
  }
  .ticker-track .sep { opacity: 0.4; }
  @keyframes tickerRun {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* SECTION STRUCTURE */
  section { padding: 120px 60px; position: relative; }

  .section-label {
    font-family: 'Space Mono', monospace;
    font-size: 10px; letter-spacing: 4px;
    color: var(--orange);
    text-transform: uppercase;
    margin-bottom: 20px;
    display: flex; align-items: center; gap: 12px;
  }
  .section-label::before {
    content: attr(data-num);
    font-size: 9px; color: rgba(247,147,26,0.4);
  }

  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1;
    letter-spacing: 1px;
    color: var(--white);
    margin-bottom: 60px;
  }
  .section-title .dim { color: rgba(255,255,255,0.2); }

  /* NO TRADING */
  .no-trading {
    background: var(--dark2);
    border-top: 1px solid rgba(247,147,26,0.1);
    border-bottom: 1px solid rgba(247,147,26,0.1);
  }
  .no-trading-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px;
    align-items: center;
  }
  .no-trading-left { }
  .no-trading-right {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
  }

  .rule-card {
    padding: 24px;
    border: 1px solid rgba(255,255,255,0.05);
    position: relative;
    transition: border-color 0.25s;
  }
  .rule-card:hover { border-color: rgba(247,147,26,0.3); }
  .rule-card.no {
    border-color: rgba(255,59,59,0.15);
  }
  .rule-card.yes {
    border-color: rgba(247,147,26,0.2);
  }
  .rule-card .rule-icon {
    font-size: 20px; margin-bottom: 12px;
  }
  .rule-card h4 {
    font-family: 'Space Mono', monospace;
    font-size: 11px; letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .rule-card.no h4 { color: var(--red); }
  .rule-card.yes h4 { color: var(--orange); }
  .rule-card p {
    font-size: 12px; color: var(--gray); line-height: 1.7;
  }

  .big-quote {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.1;
    color: var(--white);
    border-left: 3px solid var(--orange);
    padding-left: 28px;
    margin: 48px 0;
  }
  .big-quote span { color: var(--orange); }

  /* ZONES */
  .zones { background: var(--black); }
  .zones-list { display: flex; flex-direction: column; gap: 2px; }

  .zone-item {
    display: grid; grid-template-columns: 80px 1fr auto;
    align-items: start; gap: 40px;
    padding: 40px 0;
    border-top: 1px solid rgba(255,255,255,0.04);
    transition: all 0.2s;
    cursor: default;
  }
  .zone-item:last-child { border-bottom: 1px solid rgba(255,255,255,0.04); }
  .zone-item:hover { padding-left: 20px; border-top-color: rgba(247,147,26,0.2); }

  .zone-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 52px; color: rgba(247,147,26,0.15);
    line-height: 1;
    transition: color 0.2s;
  }
  .zone-item:hover .zone-num { color: var(--orange); }

  .zone-content h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px; letter-spacing: 1px;
    color: var(--white); margin-bottom: 12px;
  }
  .zone-content p {
    font-size: 13px; color: var(--gray);
    line-height: 1.8; max-width: 560px;
  }
  .zone-tags {
    display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px;
  }
  .zone-tag {
    font-family: 'Space Mono', monospace;
    font-size: 9px; letter-spacing: 2px;
    color: var(--orange); text-transform: uppercase;
    border: 1px solid rgba(247,147,26,0.2);
    padding: 4px 10px;
  }
  .zone-arrow {
    font-size: 24px; color: rgba(247,147,26,0.2);
    transition: all 0.2s; align-self: center;
  }
  .zone-item:hover .zone-arrow { color: var(--orange); transform: translateX(6px); }

  /* ORANGE CHAIR */
  .chair-section {
    background: linear-gradient(135deg, var(--dark) 0%, #1a0a00 100%);
    text-align: center;
    padding: 140px 60px;
    position: relative; overflow: hidden;
  }
  .chair-glow {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(247,147,26,0.18) 0%, transparent 70%);
    pointer-events: none;
  }
  .chair-icon {
    font-size: 100px; margin-bottom: 40px;
    position: relative; z-index: 2;
    display: inline-block;
    animation: chairFloat 3s ease-in-out infinite;
  }
  @keyframes chairFloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }
  .chair-section .section-title {
    position: relative; z-index: 2;
    margin-bottom: 28px;
  }
  .chair-philosophy {
    display: flex; justify-content: center; gap: 60px;
    margin-top: 60px; position: relative; z-index: 2;
    flex-wrap: wrap;
  }
  .phil-item {
    text-align: center; max-width: 160px;
  }
  .phil-item .phil-icon {
    font-size: 28px; margin-bottom: 12px;
    display: block;
  }
  .phil-item h4 {
    font-family: 'Space Mono', monospace;
    font-size: 10px; letter-spacing: 2px;
    color: var(--orange); text-transform: uppercase;
    margin-bottom: 8px;
  }
  .phil-item p {
    font-size: 12px; color: var(--gray); line-height: 1.6;
  }

  /* TAGLINES */
  .taglines {
    background: var(--black);
    overflow: hidden;
  }
  .tagline-row {
    display: flex; align-items: center;
    border-bottom: 1px solid rgba(247,147,26,0.06);
    padding: 32px 0;
    transition: padding-left 0.3s;
  }
  .tagline-row:hover { padding-left: 20px; }
  .tagline-row:first-child { border-top: 1px solid rgba(247,147,26,0.06); }
  .tagline-row .t-num {
    font-family: 'Space Mono', monospace;
    font-size: 10px; color: rgba(247,147,26,0.3);
    width: 60px; flex-shrink: 0;
  }
  .tagline-row .t-text {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(28px, 4vw, 56px);
    letter-spacing: 2px;
    color: rgba(255,255,255,0.15);
    transition: color 0.3s;
    flex: 1;
  }
  .tagline-row:hover .t-text { color: var(--white); }
  .tagline-row .t-arrow { color: rgba(247,147,26,0); transition: color 0.3s; font-size: 28px; }
  .tagline-row:hover .t-arrow { color: var(--orange); }

  /* CIRCULAR ECONOMY */
  .economy { background: var(--dark2); }
  .economy-flow {
    display: flex; align-items: center; justify-content: center;
    gap: 0; flex-wrap: wrap; margin-top: 60px;
  }
  .eco-node {
    text-align: center; padding: 32px 28px;
    border: 1px solid rgba(247,147,26,0.15);
    min-width: 160px;
    transition: all 0.25s;
    position: relative;
  }
  .eco-node:hover {
    border-color: var(--orange);
    box-shadow: 0 0 30px rgba(247,147,26,0.1);
    transform: translateY(-4px);
  }
  .eco-node .eco-icon { font-size: 32px; margin-bottom: 12px; display: block; }
  .eco-node h4 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px; letter-spacing: 1px;
    color: var(--white); margin-bottom: 6px;
  }
  .eco-node p { font-size: 11px; color: var(--gray); line-height: 1.5; }
  .eco-arrow {
    font-size: 24px; color: rgba(247,147,26,0.3);
    padding: 0 16px; flex-shrink: 0;
  }

  /* TARGET */
  .target { background: var(--black); }
  .target-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;
  }
  .target-card {
    padding: 48px 36px;
    background: var(--dark2);
    border: 1px solid rgba(255,255,255,0.03);
    transition: all 0.25s;
    position: relative; overflow: hidden;
  }
  .target-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 2px; background: var(--orange);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.3s;
  }
  .target-card:hover::before { transform: scaleX(1); }
  .target-card:hover { background: #151515; }
  .target-card .t-emoji { font-size: 36px; margin-bottom: 20px; display: block; }
  .target-card h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px; letter-spacing: 1px;
    color: var(--white); margin-bottom: 12px;
  }
  .target-card p { font-size: 13px; color: var(--gray); line-height: 1.8; }

  /* LOCATION */
  .location-section {
    background: var(--dark);
    padding: 100px 60px;
  }
  .location-inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;
  }
  .location-info h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 64px; line-height: 1; letter-spacing: 1px;
    color: var(--white); margin-bottom: 32px;
  }
  .location-info h2 span { color: var(--orange); }
  .location-detail {
    display: flex; flex-direction: column; gap: 16px;
  }
  .loc-row {
    display: flex; gap: 16px; align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .loc-row .loc-icon {
    font-size: 16px; flex-shrink: 0; margin-top: 2px;
  }
  .loc-row .loc-text label {
    font-family: 'Space Mono', monospace;
    font-size: 9px; letter-spacing: 3px;
    color: var(--orange); text-transform: uppercase;
    display: block; margin-bottom: 4px;
  }
  .loc-row .loc-text span {
    font-size: 14px; color: var(--light);
  }
  .map-placeholder {
    background: var(--dark2);
    border: 1px solid rgba(247,147,26,0.15);
    aspect-ratio: 1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 16px;
    position: relative; overflow: hidden;
  }
  .map-placeholder::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(247,147,26,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247,147,26,0.04) 1px, transparent 1px);
    background-size: 30px 30px;
  }
  .map-dot {
    width: 16px; height: 16px;
    background: var(--orange);
    border-radius: 50%;
    box-shadow: 0 0 0 8px rgba(247,147,26,0.15), 0 0 0 20px rgba(247,147,26,0.06);
    animation: dotPulse 2s ease-out infinite;
    position: relative; z-index: 1;
  }
  @keyframes dotPulse {
    0% { box-shadow: 0 0 0 0 rgba(247,147,26,0.4); }
    70% { box-shadow: 0 0 0 24px rgba(247,147,26,0); }
    100% { box-shadow: 0 0 0 0 rgba(247,147,26,0); }
  }
  .map-label {
    font-family: 'Space Mono', monospace;
    font-size: 10px; letter-spacing: 2px;
    color: var(--orange); text-transform: uppercase;
    position: relative; z-index: 1; text-align: center;
  }

  /* FOOTER */
  footer {
    background: var(--black);
    border-top: 1px solid rgba(247,147,26,0.1);
    padding: 60px;
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 40px; flex-wrap: wrap;
  }
  .footer-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 48px; letter-spacing: 2px;
    color: var(--white); line-height: 1;
  }
  .footer-logo span { color: var(--orange); }
  .footer-tagline {
    font-family: 'Space Mono', monospace;
    font-size: 10px; letter-spacing: 3px;
    color: var(--gray); text-transform: uppercase;
    margin-top: 8px;
  }
  .footer-right {
    text-align: right;
  }
  .footer-right p {
    font-family: 'Space Mono', monospace;
    font-size: 10px; color: rgba(136,136,136,0.4);
    letter-spacing: 1px; line-height: 2;
  }
  .footer-right a { color: var(--orange); text-decoration: none; }

  /* SCROLL ANIMATIONS */
  .reveal {
    opacity: 0; transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    nav { padding: 16px 24px; }
    .nav-links { display: none; }
    .hero { padding: 120px 24px 80px; }
    .hero-badge { display: none; }
    section { padding: 80px 24px; }
    .no-trading-grid, .location-inner { grid-template-columns: 1fr; gap: 40px; }
